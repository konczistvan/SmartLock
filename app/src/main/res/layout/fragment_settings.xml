<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_20"
        android:paddingEnd="@dimen/spacing_20"
        android:paddingTop="@dimen/spacing_50"
        android:paddingBottom="@dimen/spacing_30">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="@dimen/text_22"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_subtitle"
            android:textSize="@dimen/text_13"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_22" />

        <!-- ACCOUNT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_account"
                style="@style/TextAppearance.SectionLabel"
                android:layout_marginBottom="@dimen/spacing_14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="@dimen/circle_large"
                    android:layout_height="@dimen/circle_large"
                    android:background="@drawable/bg_circle_primary">

                    <ImageView
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_12">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_logged_in_as"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_email_placeholder"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- BLE PROXIMITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_14">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_4">

                <FrameLayout
                    android:layout_width="@dimen/circle_small"
                    android:layout_height="@dimen/circle_small"
                    android:background="@drawable/bg_circle_primary"
                    android:layout_marginEnd="@dimen/spacing_10">
                    <ImageView
                        android:layout_width="@dimen/icon_medium"
                        android:layout_height="@dimen/icon_medium"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_ble_range"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvBleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ble_placeholder"
                    android:textSize="@dimen/text_14"
                    android:textColor="@color/primary"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_ble_desc"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_10"
                android:layout_marginStart="@dimen/spacing_44"/>

            <SeekBar
                android:id="@+id/seekBarBle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="30"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_ble_min" android:textSize="@dimen/text_10" android:textColor="@color/text_hint"/>
                <View android:layout_width="0dp" android:layout_height="@dimen/spacing_1" android:layout_weight="1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_ble_max" android:textSize="@dimen/text_10" android:textColor="@color/text_hint"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16"
            android:layout_marginBottom="@dimen/spacing_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_telemetry_title"
                style="@style/TextAppearance.SectionLabel"
                android:textColor="@color/primary"
                android:layout_marginBottom="@dimen/spacing_8"/>

            <TextView
                android:id="@+id/tvLiveDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_telemetry_waiting"
                android:textSize="@dimen/text_14"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:background="@color/primary_light"
                android:padding="@dimen/spacing_10"/>
        </LinearLayout>

        <!-- GEOFENCE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_14">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_4">

                <FrameLayout
                    android:layout_width="@dimen/circle_small"
                    android:layout_height="@dimen/circle_small"
                    android:background="@drawable/bg_circle_orange"
                    android:layout_marginEnd="@dimen/spacing_10">
                    <ImageView
                        android:layout_width="@dimen/icon_medium"
                        android:layout_height="@dimen/icon_medium"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_my_location"
                        app:tint="@color/orange" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_geo_radius"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvGeoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_geo_placeholder"
                    android:textSize="@dimen/text_14"
                    android:textColor="@color/orange"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_geo_desc"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_10"
                android:layout_marginStart="@dimen/spacing_44"/>

            <SeekBar
                android:id="@+id/seekBarGeo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="490"
                android:progress="47"
                android:progressTint="@color/orange"
                android:thumbTint="@color/orange"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_geo_min" android:textSize="@dimen/text_10" android:textColor="@color/text_hint"/>
                <View android:layout_width="0dp" android:layout_height="@dimen/spacing_1" android:layout_weight="1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_geo_max" android:textSize="@dimen/text_10" android:textColor="@color/text_hint"/>
            </LinearLayout>

        </LinearLayout>

        <!-- DEADZONE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_14">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_4">

                <FrameLayout
                    android:layout_width="@dimen/circle_small"
                    android:layout_height="@dimen/circle_small"
                    android:background="@drawable/bg_circle_orange"
                    android:layout_marginEnd="@dimen/spacing_10">
                    <ImageView
                        android:layout_width="@dimen/icon_medium"
                        android:layout_height="@dimen/icon_medium"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_radar"
                        app:tint="@color/orange" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_deadzone_radius"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvDeadzoneValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_deadzone_placeholder"
                    android:textSize="@dimen/text_14"
                    android:textColor="@color/orange"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_deadzone_desc"
                android:textSize="@dimen/text_12"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_10"
                android:layout_marginStart="@dimen/spacing_44"/>

            <SeekBar
                android:id="@+id/seekBarDeadzone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="49"
                android:progress="9"
                android:progressTint="@color/orange"
                android:thumbTint="@color/orange"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_deadzone_min" android:textSize="@dimen/text_10" android:textColor="@color/text_hint"/>
                <View android:layout_width="0dp" android:layout_height="@dimen/spacing_1" android:layout_weight="1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_deadzone_max" android:textSize="@dimen/text_10" android:textColor="@color/text_hint"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ABOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_14">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_about"
                style="@style/TextAppearance.SectionLabel"
                android:layout_marginBottom="@dimen/spacing_12"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/version_label"
                    android:textSize="@dimen/text_14" android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/version_value" android:textSize="@dimen/text_14"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DANGER ZONE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_danger_zone"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_danger_zone"
                android:textSize="@dimen/text_14"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="@dimen/spacing_14"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_xlarge"
                android:text="@string/settings_log_out"
                android:textSize="@dimen/text_14"
                android:textStyle="bold"
                style="@style/Btn.Danger"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>