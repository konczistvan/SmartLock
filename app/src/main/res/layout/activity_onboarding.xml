<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_32">

        <FrameLayout
            android:layout_width="@dimen/circle_huge"
            android:layout_height="@dimen/circle_huge"
            android:background="@drawable/bg_circle_white">
            <ImageView
                android:layout_width="@dimen/icon_huge"
                android:layout_height="@dimen/icon_huge"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_welcome"
            android:textSize="@dimen/text_16"
            android:textColor="@color/text_inverse_secondary"
            android:layout_marginTop="@dimen/spacing_28"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="@dimen/text_36"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="-0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_desc"
            android:textSize="@dimen/text_14"
            android:textColor="@color/text_inverse_secondary"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_10"
            android:lineSpacingExtra="@dimen/spacing_4"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_36">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_18">
                <FrameLayout
                    android:layout_width="@dimen/circle_large"
                    android:layout_height="@dimen/circle_large"
                    android:background="@drawable/bg_circle_primary">
                    <ImageView
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/primary"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_14">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_ble_title"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_ble_desc"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_inverse_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_18">
                <FrameLayout
                    android:layout_width="@dimen/circle_large"
                    android:layout_height="@dimen/circle_large"
                    android:background="@drawable/bg_circle_orange">
                    <ImageView
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_my_location"
                        app:tint="@color/orange"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_14">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_geo_title"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_geo_desc"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_inverse_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout
                    android:layout_width="@dimen/circle_large"
                    android:layout_height="@dimen/circle_large"
                    android:background="@drawable/bg_circle_green">
                    <ImageView
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/green"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_14">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_secure_title"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_secure_desc"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_inverse_secondary"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_44">

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_xxlarge"
            android:text="@string/btn_get_started"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:backgroundTint="@color/white"
            style="@style/Widget.MaterialComponents.Button"/>

        <TextView
            android:id="@+id/tvAlreadyHaveAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/go_to_login"
            android:textColor="@color/text_inverse_secondary"
            android:textSize="@dimen/text_14"
            android:padding="@dimen/spacing_14"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_4"/>

    </LinearLayout>

</LinearLayout>