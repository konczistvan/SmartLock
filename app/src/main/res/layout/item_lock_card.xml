<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_16"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/spacing_12">

    <FrameLayout
        android:layout_width="@dimen/circle_xlarge"
        android:layout_height="@dimen/circle_xlarge"
        android:background="@drawable/bg_circle_primary">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_14">

        <TextView
            android:id="@+id/tvLockName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_name_hint"
            android:textSize="@dimen/text_15"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvLockId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_id_hint"
            android:textSize="@dimen/text_11"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/role_owner"
            android:textSize="@dimen/text_11"
            android:textColor="@color/primary"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvLockStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="@dimen/text_22"/>

</LinearLayout>