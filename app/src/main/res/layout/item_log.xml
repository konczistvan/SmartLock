<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_16"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/spacing_10">

    <FrameLayout
        android:id="@+id/ivIconBg"
        android:layout_width="@dimen/circle_xlarge"
        android:layout_height="@dimen/circle_xlarge"
        android:background="@drawable/bg_circle_green">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/green" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_12">

        <TextView
            android:id="@+id/tvAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Door Unlocked"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual unlock via app"
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_4">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_success"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_3"
                android:paddingBottom="@dimen/spacing_3"
                android:layout_marginEnd="@dimen/spacing_6">
                <TextView
                    android:id="@+id/tvDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textSize="@dimen/text_10"
                    android:textColor="@color/green"
                    android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_primary"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_3"
                android:paddingBottom="@dimen/spacing_3">
                <TextView
                    android:id="@+id/tvLockId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lock #1"
                    android:textSize="@dimen/text_10"
                    android:textColor="@color/primary"
                    android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2h ago"
        android:textSize="@dimen/text_11"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="@dimen/spacing_8"/>

</LinearLayout>