<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_16"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/spacing_10">

    <FrameLayout
        android:layout_width="@dimen/circle_large"
        android:layout_height="@dimen/circle_large"
        android:background="@drawable/bg_circle_primary">

        <ImageView
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:tint="@color/primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_12">

        <TextView
            android:id="@+id/tvDisplayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fullname_hint"
            android:textSize="@dimen/text_14"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email_hint"
            android:textSize="@dimen/text_12"
            android:textColor="@color/text_secondary"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_4">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_primary"
                android:paddingStart="@dimen/spacing_8" android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_3" android:paddingBottom="@dimen/spacing_3"
                android:layout_marginEnd="@dimen/spacing_6">
                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/role_owner"
                    android:textSize="@dimen/text_10"
                    android:textColor="@color/primary"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expiry_permanent"
                android:textSize="@dimen/text_10"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnRevoke"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_revoke"
        android:textColor="@color/red"
        android:textSize="@dimen/text_12"
        android:backgroundTint="@color/red_bg"
        style="@style/Widget.MaterialComponents.Button"/>

</LinearLayout>