<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_small"
            android:background="@drawable/bg_gradient_header"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="@dimen/spacing_22">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_lock_title"
                android:textSize="@dimen/text_22"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_lock_subtitle"
                android:textSize="@dimen/text_13"
                android:textColor="@color/text_inverse_secondary"
                android:layout_marginTop="@dimen/spacing_2"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_primary"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_14"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            android:layout_marginTop="@dimen/spacing_20">

            <ImageView
                android:layout_width="@dimen/icon_medium"
                android:layout_height="@dimen/icon_medium"
                android:src="@drawable/ic_info"
                android:layout_marginEnd="@dimen/spacing_10"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_lock_info"
                android:textSize="@dimen/text_12"
                android:textColor="@color/primary"
                android:lineSpacingExtra="@dimen/spacing_3"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20"
            android:paddingTop="@dimen/spacing_18">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/lock_name_label" style="@style/TextAppearance.SectionLabel"
                android:layout_marginBottom="@dimen/spacing_8"/>
            <EditText
                android:id="@+id/etLockName"
                android:layout_width="match_parent" android:layout_height="@dimen/btn_height_xlarge"
                android:background="@drawable/bg_input" android:hint="@string/lock_name_hint"
                android:textColorHint="@color/text_hint" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_16"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/lock_id_label" style="@style/TextAppearance.SectionLabel"
                android:layout_marginBottom="@dimen/spacing_8"/>
            <EditText
                android:id="@+id/etLockId"
                android:layout_width="match_parent" android:layout_height="@dimen/btn_height_xlarge"
                android:background="@drawable/bg_input" android:hint="@string/lock_id_hint"
                android:inputType="textCapCharacters" android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary" android:textSize="@dimen/text_15"
                android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_16"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/mac_label" style="@style/TextAppearance.SectionLabel"
                android:layout_marginBottom="@dimen/spacing_8"/>
            <EditText
                android:id="@+id/etMacAddress"
                android:layout_width="match_parent" android:layout_height="@dimen/btn_height_xlarge"
                android:background="@drawable/bg_input" android:hint="@string/mac_hint"
                android:inputType="textCapCharacters" android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary" android:textSize="@dimen/text_15"
                android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_16"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_8">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lat_label" style="@style/TextAppearance.SectionLabel"
                        android:layout_marginBottom="@dimen/spacing_8"/>
                    <EditText
                        android:id="@+id/etLatitude"
                        android:layout_width="match_parent" android:layout_height="@dimen/btn_height_xlarge"
                        android:background="@drawable/bg_input" android:hint="46.5348"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColorHint="@color/text_hint" android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_8">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lng_label" style="@style/TextAppearance.SectionLabel"
                        android:layout_marginBottom="@dimen/spacing_8"/>
                    <EditText
                        android:id="@+id/etLongitude"
                        android:layout_width="match_parent" android:layout_height="@dimen/btn_height_xlarge"
                        android:background="@drawable/bg_input" android:hint="24.5657"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColorHint="@color/text_hint" android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" android:paddingStart="@dimen/spacing_16" android:paddingEnd="@dimen/spacing_16"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/geo_hint"
                android:textSize="@dimen/text_11"
                android:textColor="@color/text_hint"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginBottom="@dimen/spacing_26"/>

            <Button
                android:id="@+id/btnAddLock"
                android:layout_width="match_parent" android:layout_height="@dimen/btn_height_xlarge"
                android:text="@string/btn_add_lock" style="@style/Btn.Primary"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/spacing_14"
                android:indeterminateTint="@color/primary" android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>